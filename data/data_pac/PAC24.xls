Sin olvidar la buena calidad.&quot;</td><td>1</td><td>Art&#237;culos Terapia</td><td>3</td><td>25</td><td>18880</td><td>472000</td><td>1</td><td>01-07-2024</td><td>MARIA INES ASENJO SOTO</td><td>DIRECTORA</td><td>64-2335492-</td><td>mariaines.asenjo@redsalud.gob.cl</td><td>01/07/2024</td><td>05/07/2024</td><td>0</td><td>&nbsp;</td><td>0</td><td>0</td><td>&nbsp;</td>
